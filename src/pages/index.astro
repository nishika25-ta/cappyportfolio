---
import Base from '../layouts/Base.astro';
import Cat from '../components/Cat.astro';
import Hand from '../components/Hand.astro';
import Icon from '../components/Icon.astro';
import CatPitch from '../components/CatPitch.astro';
import HeroDetails from '../components/HeroDetails.astro';
import CreativeUniverse from '../components/CreativeUniverse.astro';
import CosmicMemeVault from '../components/CosmicMemeVault.astro';
import {services,faqs,enquiryUrl} from '../data/site.mjs';
import {showcase} from '../data/showcase';
---
<Base>
  <section class="hero hero-stage" aria-labelledby="hero-title">
    <HeroDetails/>
    <div class="studio-atmosphere" aria-hidden="true">
      <svg class="studio-orbits" viewBox="0 0 1400 820" preserveAspectRatio="xMidYMid slice"><g fill="none" stroke="currentColor"><ellipse cx="700" cy="410" rx="620" ry="280" transform="rotate(-16 700 410)"/><ellipse cx="700" cy="410" rx="500" ry="365" transform="rotate(24 700 410)" stroke-dasharray="2 12"/></g><g class="studio-orbit-stars" fill="currentColor"><path d="M160 280l5 15 15 5-15 5-5 15-5-15-15-5 15-5zM1190 530l4 12 12 4-12 4-4 12-4-12-12-4 12-4z"/><circle cx="1145" cy="170" r="4"/><circle cx="290" cy="675" r="4"/></g></svg>
    </div>
    <div class="hero-type"><h1 id="hero-title"><span class="hero-title-small">Small business.</span><span class="hero-title-big"><span class="hero-big-word">Big</span> <span class="personality">purr-sonality<span class="hero-period">.</span><svg viewBox="0 0 700 38" aria-hidden="true"><path d="M5 23C180 0 457 0 692 15M104 32c159-14 365-16 505-10" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round"/></svg></span></span></h1><p class="hero-mobile-intro">Websites, portfolios, résumés &amp; food visuals.<br/>From RM15 in Miri, Sarawak.</p></div>
    <div class="hero-actions">
      <div class="hero-actions-row">
        <a class="button button-dark hero-button" href="#pricing">See pricing <Icon name="arrow"/></a>
        <a class="button button-outline hero-button" href="#work">View work <Icon name="arrow"/></a>
      </div>
      <a class="button button-meme hero-button-meme" href="#cosmic-memes" aria-label="Explore out of this world memes">
        <span class="hero-meme-avatar" aria-hidden="true">
          <img src="/memes/meme-cat-icon.png" alt="" width="38" height="38" class="hero-meme-cat-img" loading="eager" decoding="async" />
        </span>
        <span class="hero-meme-text">...or u need some meme?</span>
        <Icon name="arrow"/>
      </a>
    </div>
    <div class="hero-cast">
    <div class="hero-cat hero-cat-left" data-cat-scene><div class="cat-entry"><div class="hero-wiggle"><div class="cursor-rig" data-cursor-depth="-1"><Cat variant="developer"/><CatPitch speaker="developer"/></div></div></div></div>
    <div class="hero-cat hero-cat-right" data-cat-scene><div class="cat-entry"><div class="hero-wiggle"><div class="cursor-rig" data-cursor-depth="1"><Cat variant="orange"/><CatPitch speaker="orange"/></div></div></div><span class="purr-heart" aria-hidden="true">♡</span></div>
    </div>
    <div class="hero-satellite satellite-left" aria-hidden="true"><div class="satellite-entry"><Cat variant="resume"/></div></div><div class="hero-satellite satellite-right" aria-hidden="true"><div class="satellite-entry"><Cat variant="chef"/></div></div>
    <Hand class="hero-hand"/>
    <div class="hero-float float-code" aria-hidden="true">&lt;/&gt;</div><div class="hero-float float-squiggle" aria-hidden="true">〰</div>
    <svg class="hero-spark" viewBox="0 0 80 80" aria-hidden="true"><path d="M40 3v74M3 40h74M14 14l52 52m0-52L14 66" stroke="currentColor" stroke-width="5" stroke-linecap="round"/></svg>
    <div class="miri-stamp"><Icon name="paw"/><span>Creative<br/>studio.</span><small>MIRI, SARAWAK</small></div>
    <div class="hero-bottom wrap"><span>Websites · Portfolios · Résumés · Food Visuals</span></div>
    <CreativeUniverse/>
    <svg class="hero-ground" viewBox="0 0 1440 180" preserveAspectRatio="none" aria-hidden="true"><path d="M0 75C280 5 480 160 760 80S1200 25 1440 65V180H0Z" fill="currentColor"/></svg>
  </section>

  <section id="services" class="services-section" aria-labelledby="services-title">
    <svg class="section-wave" viewBox="0 0 1440 85" preserveAspectRatio="none" aria-hidden="true"><path d="M0 45C300-30 460 110 790 45S1190 0 1440 40V85H0Z"/></svg>
    <div class="wrap"><div class="section-heading services-heading"><div><span class="section-kicker">Services</span><h2 id="services-title">What I build<span>.</span></h2></div></div>
      <div class="service-cats">
        {services.map((service,i)=><button type="button" class:list={['service-cat',`service-${service.id}`]} data-pick-service={service.id} data-character={service.id} aria-pressed={i===0?'true':'false'} aria-controls={`playground-${service.id} pricing-${service.id}`}>
          <div class="service-cat-top"><span class="service-from"><span class="service-index" aria-hidden="true">0{i+1} / </span>From RM{service.from}</span><span class="service-arrow"><Icon name="diagonal"/></span></div>
          <div class="service-cat-label"><span class="service-name">{service.title}</span><span class="service-short">{service.short}</span></div>
          <div class="service-illustration"><div class="service-cursor-rig"><Cat variant={service.id==='websites'?'developer':service.id==='portfolios'?'orange':service.id==='resumes'?'resume':'chef'}/></div></div>
        </button>)}
      </div>
      <div class="services-bottom"><Icon name="paw"/><span>Tap a card to preview or see pricing.</span><Icon name="paw"/></div>
    </div>
  </section>

  <section id="playground" class="playground-section" aria-labelledby="playground-title">
    <svg class="playground-sky" viewBox="0 0 1440 300" preserveAspectRatio="none" aria-hidden="true"><path d="M0 0H1440V145C1120 40 1060 240 740 135S280 260 0 150Z" fill="currentColor"/></svg>
    <svg class="playground-doodles" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="3"><path d="M-20 290C180 40 240 390 50 430S-90 640 200 740"/><path d="M1100-40C880 140 1330 130 1250 330S1450 550 1500 690"/><path d="m100 90 25 15 15-35m1100 530 22 40 45-10"/><circle cx="290" cy="670" r="30"/><path d="m1140 550 45-40 40 45-45 40Z"/></g></svg>
    <div class="playground-heading"><span class="section-kicker">Interactive preview</span><h2 id="playground-title" tabindex="-1">Turn up the<br/> purr-sonality.</h2></div>
    <div class="playground-stage">
      <div class="playground-cast" data-energy-mood="playful">
      {services.map((s,i)=><div class="playground-character" id={`playground-${s.id}`} data-playground-character={s.id} hidden={i!==0}><Cat interactive variant={s.id==='websites'?'developer':s.id==='portfolios'?'orange':s.id==='resumes'?'resume':'chef'}/></div>)}
      <div class="playground-hand-track"><Hand class="playground-hand"/></div>
      <div class="pet-hearts" aria-hidden="true"><span>♡</span><span>♡</span><span>✦</span></div>
      </div>
    </div>
    <button class="pet-button" data-pet-cat type="button" aria-label="Pet the cat"><Icon name="paw"/> Pet the cat</button>
    <div class="energy-control"><div class="energy-labels"><label for="creative-energy">Energy level</label><output id="energy-state" for="creative-energy">Feeling playful</output></div><input id="creative-energy" type="range" min="0" max="100" value="55" aria-label="Creative energy" aria-describedby="energy-help"/><div class="energy-extremes" aria-hidden="true"><span>Calm</span><span>Full of beans</span></div><p id="energy-help">Slide to adjust energy.</p></div>
    <div class="playground-actions"><a class="button button-dark" href="#pricing-websites" data-pick-service="websites" data-explore-packages>Explore website packages <Icon name="arrow"/></a><p id="playground-status" role="status" aria-live="polite">Ready when you are.</p></div>
  </section>


  <section id="work" class="work-section wrap" aria-labelledby="work-title">
    <div class="section-heading"><div><span class="section-kicker">Selected work</span><h2 id="work-title">Recent builds<span class="coral-text">.</span></h2></div><p>Live demos across starter, business, and custom tiers.</p></div>
    <div class="showcase-layout">
      <button type="button" class="cinema-buddy" data-studio-pet aria-label="Pet the cinema cat"><span data-cinema-greeting>cinema buddy</span><div class="cinema-cat-crop"><Cat variant="resume"/></div></button>
      <div class="showcase-player">
        <div class="player-top"><span><span class="status-dot"></span> CAPPY’S SHOWCASE</span><span class="player-dots" aria-hidden="true">● ● ●</span></div>
        {showcase.map((clip,i)=><div class="showcase-scene" id={`showcase-${clip.id}`} role="tabpanel" aria-labelledby={`showcase-tab-${clip.id}`} hidden={i!==0}>
          {clip.src ? <button class="video-poster" data-video-src={clip.src} data-video-title={clip.title} aria-label={`Play ${clip.title}`}><video data-src={clip.src} poster={clip.poster} muted loop playsinline preload="none" width="1200" height="800" aria-hidden="true"></video><span class="play-circle" aria-hidden="true"><Icon name="play"/></span><span class="preview-badge">Watch demo</span></button> : <div class:list={['showcase-placeholder',`preview-${clip.id}`]}><span class="preview-badge">SHOWCASE</span><div class="preview-stage"><span class="preview-deco preview-deco-left">✳</span><Cat variant={clip.id==='resumes'?'resume':clip.id==='food'?'chef':'developer'}/><span class="preview-deco preview-deco-right">✦</span></div><p class="preview-title">{clip.id==='resumes'?'Clean, ATS-ready resumes.':clip.id==='food'?'Bright, natural food photos.':'Clean, fast websites.'}</p><span class="preview-caption">{clip.label} · Demo coming soon</span></div>}
        </div>)}
        <div class="player-bottom"><span>Click video to expand</span><span>✦</span></div>
      </div>
      <div class="showcase-copy"><span class="hand-note">live demos ↙</span><div class="showcase-tabs" role="tablist" aria-label="Showcase category">{showcase.map((clip,i)=><button id={`showcase-tab-${clip.id}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`showcase-${clip.id}`} tabindex={i===0?0:-1} data-showcase={clip.id}>{clip.label}</button>)}</div>
        {showcase.map((clip,i)=><div id={`showcase-copy-${clip.id}`} data-showcase-copy={clip.id} hidden={i!==0}><h3>{clip.title}</h3><p>{clip.description}</p></div>)}
      </div>
    </div>
    <div class="artwork-heading"><h3>Service posters</h3><span>Click any poster to view full size.</span></div>
    <div class="artwork-gallery">{services.map(service=><a class="artwork-card" href={service.artwork} data-poster-src={service.artwork} data-poster-title={`${service.title} — Studio poster`}><div class="artwork-image"><img src={service.artwork} alt={`${service.title} service artwork with cat characters and package overview`} width="1200" height="800" loading="lazy" decoding="async"/></div><span>{service.title}<Icon name="diagonal"/></span></a>)}</div>
  </section>

  <CosmicMemeVault/>

  <section id="pricing" class="pricing-section" aria-labelledby="pricing-title"><div class="wrap">
    <div class="section-heading"><div><span class="section-kicker">Pricing</span><h2 id="pricing-title">Simple, upfront<br/>packages<span class="coral-text">.</span></h2></div><div><p>Pick a package and message me on WhatsApp.</p></div></div>
    <div class="pricing-tabs" role="tablist" aria-label="Service pricing">{services.map((service,i)=><button id={`pricing-tab-${service.id}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`pricing-${service.id}`} tabindex={i===0?0:-1} data-service-tab={service.id}><Icon name={service.icon}/>{service.title}<span class="tab-from">from RM{service.from}</span></button>)}</div>
    {services.map((service,i)=><div class="pricing-panel" id={`pricing-${service.id}`} role="tabpanel" aria-labelledby={`pricing-tab-${service.id}`} hidden={i!==0}>
      <div class="pricing-intro"><h3>{service.label}</h3>{service.id!=='websites'&&<p>{service.description}</p>}</div>
      <div class="package-grid">{service.packages.map((pkg,j)=><article class:list={['package',j===1&&'package-featured']}><div class="package-meta"><span>{j===0?'Starter':j===1?'Popular':'Complete'}</span><Icon name={j===2?'star':'paw'}/></div><h4>{pkg.name}</h4><p class="package-description">{pkg.description}</p><div class="package-price"><span>RM</span>{pkg.price}<small>/ package</small></div><a class:list={['button',j===1?'button-dark':'button-outline']} href={enquiryUrl(pkg.name,pkg.price)} target="_blank" rel="noopener noreferrer">Enquire on WhatsApp<Icon name="diagonal"/></a><ul>{pkg.features.map(feature=><li><Icon name="check"/>{feature}</li>)}</ul></article>)}</div>
      {service.addons.length>0 && <div class="addons"><div class="addons-header"><span class="addons-title"><span class="addons-badge" aria-hidden="true"><Icon name="star"/></span><span><strong>Optional add-ons</strong><small>Extra pages, setup &amp; updates</small></span></span><span class="addons-tag"><Icon name="paw"/> Add-ons</span></div><div class="addons-table-wrap"><table class="addons-table addon-list" aria-label={`${service.title} optional add-ons`}><thead><tr><th scope="col">Add-on</th><th scope="col">Price</th></tr></thead><tbody>{service.addons.map(([label,price],idx)=>{const [amount,unit]=price.includes('/')?price.split('/').map(s=>s.trim()):price.endsWith(' each')?[price.slice(0,-5),'each']:[price,''];return <tr><th scope="row"><span class="addon-index" aria-hidden="true">0{idx+1}</span><span class="addon-name">{label}</span></th><td><div class="addon-price-box"><strong class="addon-price-pill">{amount.replaceAll('–',' – ')}</strong>{unit && <small class="addon-price-sub">{unit.replace(',',' ·')}</small>}</div></td></tr>;})}</tbody></table></div></div>}
      <div class="pricing-footnote"><p>{service.note.replaceAll('–',' to ')}</p><a class="sheet-link" href={service.sheet} data-poster-src={service.sheet} data-poster-title={`${service.title} — Price sheet`}>View price sheet <Icon name="diagonal"/></a></div>
    </div>)}
    <noscript><p class="nojs-note">All packages are listed below. Each enquiry button opens WhatsApp with the package details.</p><style is:global>.pricing-panel[hidden],.showcase-scene[hidden]{display:block!important}.pricing-tabs,.showcase-tabs,[data-preview-video],.preview-help{display:none!important}</style></noscript>
  </div></section>

  <section class="about-section wrap" aria-labelledby="about-title">
    <div class="about-card">
      <div class="about-card-topbar" aria-hidden="true">
        <span class="about-window-dots"><i></i><i></i><i></i></span>
        <span class="about-window-label"><Icon name="paw"/> CAPPY’S STUDIO DOSSIER · MIRI, SARAWAK</span>
      </div>
      <div class="about-grid">
        <div class="about-art">
          <span class="hand-note">Miri, Sarawak ♡</span>
          <a class="about-postcard" href="/artwork/about.webp" data-poster-src="/artwork/about.webp" data-poster-title="About Cappy — Studio postcard" aria-label="View full-size About Cappy studio poster">
            <span class="about-tape" aria-hidden="true"></span>
            <div class="about-postcard-frame">
              <img src="/artwork/about.webp" alt="CappyTheDev about-me artwork: a friendly cat at a laptop with notes about website design, resumes and food visuals in Miri" width="1200" height="800" loading="lazy" decoding="async"/>
            </div>
            <div class="about-postcard-caption">
              <span><Icon name="paw"/> Studio desk notes &amp; services</span>
              <span class="about-expand-pill">Expand <Icon name="diagonal"/></span>
            </div>
          </a>
          <span class="postcard-stamp">MADE IN MIRI <Icon name="paw"/></span>
        </div>
        <div class="about-copy">
          <span class="section-kicker about-kicker"><Icon name="star"/> Independent Maker</span>
          <h2 id="about-title">Hey, I’m Cappy<span class="coral-text">.</span></h2>
          <p class="about-lead">I’m an independent developer and designer in <strong>Miri, Sarawak</strong> crafting websites, portfolios, résumés, and food visuals with big personality.</p>
          <p>You work directly with me from first message to launch—no agency middlemen, just clear scope, fast turnaround, and honest upfront pricing.</p>
          <div class="about-tags" aria-label="Why work with Cappy">
            <div class="about-tag-card"><span class="about-tag-icon tag-butter" aria-hidden="true"><Icon name="check"/></span><div><strong>Direct communication</strong><small>1-on-1 from start to finish</small></div></div>
            <div class="about-tag-card"><span class="about-tag-icon tag-pink" aria-hidden="true"><Icon name="star"/></span><div><strong>Fast turnaround</strong><small>Delivered in days, not weeks</small></div></div>
            <div class="about-tag-card"><span class="about-tag-icon tag-sky" aria-hidden="true"><Icon name="code"/></span><div><strong>Clean, modern builds</strong><small>Mobile-ready &amp; built to last</small></div></div>
            <div class="about-tag-card"><span class="about-tag-icon tag-green" aria-hidden="true"><Icon name="paw"/></span><div><strong>Upfront RM pricing</strong><small>Simple packages from RM15</small></div></div>
          </div>
          <div class="about-actions">
            <a class="button button-dark" href="/about/">More about me <Icon name="arrow"/></a>
            <a class="button button-outline" href={enquiryUrl()} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp"/> Chat on WhatsApp <Icon name="diagonal"/></a>
          </div>
        </div>
      </div>
    </div>
  </section>


  <section class="faq-section wrap" aria-labelledby="faq-title">
    <div class="faq-intro">
      <span class="section-kicker faq-kicker"><Icon name="paw"/> Studio FAQ</span>
      <h2 id="faq-title">Common<br/>questions<span class="coral-text">.</span></h2>
      <p class="faq-subtitle">Quick answers on turnaround times, revisions, and how we get your project live.</p>
      <div class="faq-helper-card">
        <div class="faq-helper-stage">
          <span class="faq-speech-bubble">Need a custom quote? Meow at me!</span>
          <Cat variant="peek" class="faq-cat"/>
        </div>
        <div class="faq-helper-body">
          <strong>Still have a question?</strong>
          <p>Message me directly on WhatsApp and I’ll reply with a clear answer.</p>
          <a class="button button-dark faq-whatsapp-btn" href={enquiryUrl()} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp"/> Ask on WhatsApp <Icon name="diagonal"/></a>
        </div>
      </div>
    </div>
    <div class="faq-list">
      {faqs.map(([q,a],idx)=><details class="faq-item">
        <summary>
          <span class="faq-question-wrap">
            <span class="faq-index" aria-hidden="true">0{idx+1}</span>
            <span class="faq-question-text">{q}</span>
          </span>
          <span class="faq-plus" aria-hidden="true">+</span>
        </summary>
        <div class="faq-answer">
          <p>{a.replaceAll('–',' to ')}</p>
        </div>
      </details>)}
    </div>
  </section>

  <dialog id="video-dialog" aria-labelledby="video-dialog-title"><div class="dialog-top"><h2 id="video-dialog-title">Video preview</h2><button class="dialog-close" aria-label="Close video">×</button></div><video id="dialog-video" controls playsinline preload="metadata"></video><p class="dialog-note">Your local preview is only visible on this device. To publish a showcase, add your video to the site’s video folder.</p></dialog>
  <dialog id="poster-dialog" class="poster-dialog" aria-labelledby="poster-dialog-title"><div class="dialog-top"><h2 id="poster-dialog-title">Studio poster</h2><button type="button" class="dialog-close" aria-label="Close poster">×</button></div><div class="poster-dialog-body"><img id="dialog-poster" alt="" width="1536" height="1024" decoding="async"/></div></dialog>
</Base>
