---
import Base from '../layouts/Base.astro';
import Cat from '../components/Cat.astro';
import Icon from '../components/Icon.astro';
import {enquiryUrl} from '../data/site.mjs';
---
<Base title="About CappyTheDev" description="Meet CappyTheDev, an independent developer and designer in Miri, Sarawak building websites, portfolios, resumes, and food visuals.">
  <section class="about-page-hero wrap"><a class="text-link" href="/">← Back to home</a><div class="about-page-grid"><div><span class="section-kicker">About</span><h1>One developer.<br/>Clear work.<br/><span class="coral-text">Cat energy.</span></h1><p>I’m Cappy, an independent developer and designer in Miri, Sarawak building websites, portfolios, resumes, and food visuals.</p><a class="button button-dark" href={enquiryUrl()} target="_blank" rel="noopener noreferrer">Message on WhatsApp <Icon name="diagonal"/></a></div><div class="about-page-cat"><Cat variant="developer"/><span class="hand-note">based in Miri ↖</span></div></div></section>
  <section class="about-story wrap"><h2>Simple process,<br/>direct work.</h2><div><p>You don’t need a massive budget or a long brief to get started—whether it’s a website for your business, a portfolio for your projects, a sharper resume, or clean food photos.</p><p>You work directly with me from start to finish with clear pricing and fast turnaround.</p><a class="text-link" href="/#pricing">See packages <Icon name="arrow"/></a></div></section>
  <section class="about-full-art wrap"><img src="/artwork/about.webp" alt="CappyTheDev studio poster featuring Miri, Sarawak, website design, resume services and food visuals" width="1200" height="800" loading="lazy"/></section>
</Base>
