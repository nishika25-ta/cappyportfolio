---
import Icon from './Icon.astro';
import {enquiryUrl} from '../data/site.mjs';
---
<header class="site-header wrap">
 <div class="header-shell">
  <a class="wordmark" href="/" aria-label="CappyTheDev home"><Icon name="paw"/><span>Cappy<span class="wordmark-light">TheDev</span><span class="logo-dot">.</span></span></a>
  <nav aria-label="Main navigation" id="main-nav">
    <a class="nav-link nav-services" href="/#services"><Icon name="code"/><span>Services</span></a><a class="nav-link nav-work" href="/#work"><Icon name="star"/><span>Work</span></a><a class="nav-link nav-pricing" href="/#pricing"><Icon name="paw"/><span>Pricing</span></a><a class="nav-link nav-about" href="/about/" aria-current={Astro.url.pathname.startsWith('/about')?'page':undefined}><Icon name="document"/><span>About</span></a>
  </nav>
  <a class="button button-small header-cta" href={enquiryUrl()} target="_blank" rel="noopener noreferrer">Chat with Cappy <Icon name="diagonal"/></a>
  <button class="menu-toggle" aria-label="Open menu" aria-controls="main-nav" aria-expanded="false"><span></span><span></span></button>
 </div>
</header>
<noscript><style is:global>.site-header .header-shell{flex-wrap:wrap;border-radius:26px}.site-header nav{flex-wrap:wrap;max-height:none;overflow:visible}@media(max-width:1000px){.site-header{height:auto}.site-header nav{display:flex!important;position:static;flex-direction:row;flex-basis:100%;padding:8px 0;background:none;border:0;box-shadow:none}.site-header .menu-toggle{display:none}}</style></noscript>
