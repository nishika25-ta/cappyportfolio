---
import Cat from './Cat.astro';
import Icon from './Icon.astro';
import {enquiryUrl} from '../data/site.mjs';
---
<footer id="contact" class="site-footer">
  <div class="wrap contact-top"><a class="back-top" href="#top">Back to top ↑</a></div>
  <div class="wrap contact-main"><div><h2>Ready to start<br/>a project<span class="coral-text">?</span></h2><p>Send a message on WhatsApp for a quick quote.</p><a class="button button-dark" href={enquiryUrl()} target="_blank" rel="noopener noreferrer"><Icon name="whatsapp"/> Chat on WhatsApp <Icon name="diagonal"/></a></div><div class="contact-cat"><span class="hand-note">say hello ↙</span><Cat variant="orange"/></div></div>
  <div class="wrap footer-bottom"><a class="wordmark" href="/"><Icon name="paw"/>CappyTheDev.</a><p>Independent creative services · Miri, Sarawak</p><span>© {new Date().getFullYear()} CappyTheDev</span></div>
</footer>
<style>.contact-top{justify-content:flex-end}</style>
