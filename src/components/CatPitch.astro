---
interface Props { speaker: 'developer' | 'orange'; }
const { speaker } = Astro.props;
const messages = speaker === 'developer' ? [
  { title: 'Thousands for a website? Meow, why?', copy: 'From RM129. Save the rest for treats.' },
  { title: 'Your business deserves its own little home.', copy: 'A proper website. A very friendly price.' },
  { title: 'Open for business. Even during cat naps.', copy: 'Let your website do the introductions.' },
  { title: 'Big ideas. Tiny budget? Come sit with us.', copy: 'Start small. Look like you mean business.' },
  { title: 'Pretty is good. Easy to use is purr-fect.', copy: 'Clear pages. Handy buttons. Happy humans.' },
  { title: 'Less “link in bio.” More “look at me!”', copy: 'Give your business a place to shine.' },
] : [
  { title: 'No job promises. Plenty of paw-lish.', copy: 'Your résumé, looking its best.' },
  { title: 'AI food looking a little… fishy?', copy: 'Real food. Tasty edits. No weird extras.' },
  { title: 'Your experience has a story. Let it shine.', copy: 'Clean résumés. Clear words. Still you.' },
  { title: 'Good food deserves a good first bite.', copy: 'Even when that first bite is with your eyes.' },
  { title: 'Messy résumé? Slide it under my paw.', copy: 'A little tidy-up. A much sharper impression.' },
  { title: 'Keep the flavour. Lose the bad lighting.', copy: 'Your actual dish, on its best-looking day.' },
];
---
<aside class:list={['cat-speech', `cat-speech-${speaker}`]} aria-label={speaker === 'developer' ? 'The coding cat says' : 'The orange cat says'}>
  <div class="cat-speech-body">
  <svg class="cat-speech-tail" viewBox="0 0 44 36" aria-hidden="true"><path d="M43 3Q24 14 13 29Q32 25 43 22"/></svg>
  <div class="cat-speech-messages">
  {messages.map((message, i) => <div class="cat-speech-message" data-cat-pitch={i} data-active={i === 0 ? 'true' : 'false'} aria-hidden={i !== 0 ? 'true' : 'false'}>
    <p class="cat-speech-title">{message.title}</p>
    <p class="cat-speech-copy">{message.copy}</p>
  </div>)}
  </div>
  <span class="cat-speech-dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>
</aside>
