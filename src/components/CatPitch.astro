---
interface Props { speaker: 'developer' | 'orange'; }
const { speaker } = Astro.props;
const messages = speaker === 'developer' ? [
  { title: 'Websites from RM129.', copy: 'Fast, mobile-ready sites for local businesses.' },
  { title: 'Need a dev portfolio?', copy: 'Personal sites for grads, devs & designers.' },
  { title: '48-hour starter turnaround.', copy: 'Direct WhatsApp booking included.' },
] : [
  { title: 'ATS-friendly résumés.', copy: 'Clean formatting & sharp wording from RM19.' },
  { title: 'Natural food photo edits.', copy: 'Real dishes, brighter colours, from RM15.' },
  { title: 'Simple, upfront pricing.', copy: 'No hidden fees or agency markups.' },
];
---
<aside class:list={['cat-speech', `cat-speech-${speaker}`]} aria-label={speaker === 'developer' ? 'The coding cat says' : 'The orange cat says'}>
  <div class="cat-speech-body">
  <svg class="cat-speech-tail" viewBox="0 0 44 36" aria-hidden="true"><path d="M43 3Q24 14 13 29Q32 25 43 22"/></svg>
  <div class="cat-speech-messages">
  {messages.map((message, i) => <div class="cat-speech-message" data-cat-pitch={i} data-active={i === 0 ? 'true' : 'false'} aria-hidden={i !== 0 ? 'true' : 'false'}>
    <p class="cat-speech-title">{message.title}</p>
    <p class="cat-speech-copy">{message.copy}</p>
  </div>)}
  </div>
  <span class="cat-speech-dots" aria-hidden="true"><i></i><i></i><i></i></span>
  </div>
</aside>
